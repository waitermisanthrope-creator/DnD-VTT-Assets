{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DnD-VTT Unity asset pack metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "license",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "unityVersion": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "android": {
          "$ref": "#/$defs/artifact"
        },
        "windows": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "bytes",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
